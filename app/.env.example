# Salin file ini menjadi  .env.local  (file itu TIDAK ikut ke git) lalu isi nilainya sendiri.
# Ambil dari dashboard Supabase → Project Settings → API (atau "Connect" → App Frameworks).

# URL proyek, mis. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Kunci publik untuk browser: "anon public" (format eyJ...) atau "publishable" (format sb_publishable_...).
# JANGAN pernah isi service_role / secret key di sini — kunci itu hanya untuk server (Edge Function).
VITE_SUPABASE_ANON_KEY=

# Kunci publik VAPID untuk notifikasi push (lihat docs/04-SETUP-SUPABASE.md langkah 5).
VITE_VAPID_PUBLIC_KEY=
